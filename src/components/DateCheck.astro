---
import { partyPackages, towns } from "../data/pricing";
---

<form class="panel grid gap-4 md:grid-cols-4" action="/book" method="get">
  <label>
    Package
    <select name="pkg" id="home-pkg">
      {partyPackages.map((pkg) => (
        <option value={pkg.id} selected={pkg.id === "mission"}>{pkg.name} · {pkg.timeLabel}</option>
      ))}
    </select>
  </label>
  <label>
    Date
    <input type="date" name="date" required />
  </label>
  <label>
    Town
    <select name="town" id="home-town">
      {towns.map((town) => (
        <option value={town.id} selected={town.id === "killeen"}>{town.name}</option>
      ))}
      <option value="beyond">Outside the usual area</option>
    </select>
  </label>
  <div style="align-self: end">
    <button class="btn btn-ghost btn-block" type="submit">Request a date</button>
  </div>
  <p id="town-fee" class="muted md:col-span-4" aria-live="polite"></p>
</form>

<script>
  import { towns } from "../data/pricing";

  const select = document.querySelector<HTMLSelectElement>("#home-town");
  const out = document.querySelector<HTMLElement>("#town-fee");
  if (select && out) {
    const update = () => {
      const town = towns.find((item) => item.id === select.value);
      if (!town || town.fee !== 0) {
        const name = town?.name ?? "This trip";
        out.textContent = `${name} is outside Killeen, Copperas Cove, Harker Heights, and Nolanville. That trip is by exception only. It has to be approved ahead of time. Prices vary. A 4-hour minimum may be required.`;
        return;
      }
      out.textContent = `${town.name} is in the usual area. Travel is free.`;
    };
    select.addEventListener("change", update);
    update();
  }
</script>
