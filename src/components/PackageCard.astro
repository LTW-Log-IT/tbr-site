---
import CallToBook from "./CallToBook.astro";
import { site, squarePackageHref } from "../config/site";
import { COMMUNITY_DISCOUNT, DEPOSIT, money, type CatalogPackage } from "../data/pricing";

interface Props {
  pkg: CatalogPackage;
  compact?: boolean;
}

const { pkg, compact = false } = Astro.props;
const packagePay = squarePackageHref(pkg.id);
---

<article class="pkg-card" id={pkg.id}>
  <p class="pkg-kicker">
    <span>{pkg.hourly ? "Mon–Thu" : "Any day"}</span>
  </p>
  <h3 class="metal">{pkg.name}</h3>
  <p class="pkg-meta">{pkg.timeLabel}</p>
  {pkg.hourly ? (
    <p class="pkg-price">{money(pkg.weekdayPrice)}<span class="pkg-unit">/hr</span></p>
  ) : (
    <>
      <p class="pkg-price">{money(pkg.weekdayPrice)}</p>
    </>
  )}
  <p class="muted">{pkg.summary}</p>
  {!compact && (
    <ul class="checks">
      {pkg.includes.map((item) => <li>{item}</li>)}
    </ul>
  )}
  {pkg.note && !compact && <p class="muted">{pkg.note}</p>}
  {!compact && (
    pkg.hourly ? (
      <p class="muted">
        $25 off the hourly total once with an ID, not $25 an hour. One discount per booking. Discounts do not stack. Travel and add-ons stay full price. Call or text to apply it.
      </p>
    ) : (
      <p class="muted">
        $25 off with an ID: {money(pkg.weekdayPrice)} − {money(COMMUNITY_DISCOUNT)} = {money(pkg.weekdayPrice - COMMUNITY_DISCOUNT)}. One discount per booking. Discounts do not stack. Travel and add-ons stay full price. Square charges the full package price. Call or text to take the $25 off.
      </p>
    )
  )}
  {compact ? (
    <a class="btn btn-primary" href={`/book?pkg=${pkg.id}`}>Book Now</a>
  ) : (
    <CallToBook />
  )}
  {!compact && (
  <div class="pay-links">
    {packagePay && (
      <a class="btn btn-ghost btn-block" href={packagePay} target="_blank" rel="noopener noreferrer">
        Pay package · {money(pkg.weekdayPrice)}
      </a>
    )}
    <a class="btn btn-ghost btn-block" href={site.squareLinks.deposit} target="_blank" rel="noopener noreferrer">
      Pay deposit · {money(DEPOSIT)}
    </a>
  </div>
  )}
  <a class="inline-link" href={`/book?pkg=${pkg.id}`}>Request a date</a>
</article>
