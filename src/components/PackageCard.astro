---
import CallToBook from "./CallToBook.astro";
import { site, squarePackageHref } from "../config/site";
import { DEPOSIT, money, type CatalogPackage } from "../data/pricing";

interface Props {
  pkg: CatalogPackage;
}

const { pkg } = Astro.props;
const weekdayPay = squarePackageHref(pkg.id, "weekday");
const weekendPay = pkg.weekendPrice == null ? undefined : squarePackageHref(pkg.id, "weekend");
---

<article class="pkg-card" id={pkg.id}>
  <p class="pkg-kicker">
    <span>{pkg.hourly ? "Weekdays" : "Mon–Thu / Fri–Sun"}</span>
  </p>
  <h3 class="metal">{pkg.name}</h3>
  <p class="pkg-meta">{pkg.timeLabel}</p>
  {pkg.hourly ? (
    <p class="pkg-price">{money(pkg.weekdayPrice)}<span class="pkg-unit">/hr</span></p>
  ) : (
    <>
      <p class="pkg-price">{money(pkg.weekdayPrice)}</p>
      <p class="pkg-meta">Fri–Sun {money(pkg.weekendPrice ?? pkg.weekdayPrice)}</p>
    </>
  )}
  <p class="muted">{pkg.summary}</p>
  <ul class="checks">
    {pkg.includes.map((item) => <li>{item}</li>)}
  </ul>
  {pkg.note && <p class="muted">{pkg.note}</p>}
  <CallToBook />
  <div class="pay-links">
    {weekdayPay && (
      <a class="btn btn-ghost btn-block" href={weekdayPay} target="_blank" rel="noopener noreferrer">
        Pay package · Mon–Thu {money(pkg.weekdayPrice)}
      </a>
    )}
    {weekendPay && (
      <a class="btn btn-ghost btn-block" href={weekendPay} target="_blank" rel="noopener noreferrer">
        Pay package · Fri–Sun {money(pkg.weekendPrice ?? pkg.weekdayPrice)}
      </a>
    )}
    <a class="btn btn-ghost btn-block" href={site.squareLinks.deposit} target="_blank" rel="noopener noreferrer">
      Pay deposit · {money(DEPOSIT)}
    </a>
  </div>
  <a class="inline-link" href={`/book?pkg=${pkg.id}`}>Request a date</a>
</article>
