---
import { nav, phoneLabel, site } from "../config/site";
---

<footer class="site-footer">
  <div class="wrap grid gap-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img class="brand-logo brand-logo-footer" src={site.logo.chrome} alt="B4TTL3" width="2096" height="944" />
      <p class="footer-word metal">Team Battle Ready</p>
      <p class="value-row" style="margin-top: 0.8rem">
        {site.values.join("  ")}
      </p>
      <p class="fine" style="margin-top: 1rem">
        Team Battle Ready is an independent Central Texas car club and a mobile gaming trailer serving Killeen and Fort Hood.
      </p>
      <p class="fine" style="margin-top: 0.7rem">
        The truck and trailer need a driveway or side street where they can legally park. Confirm the spot before the date. If it will not work, call or text and we will figure out another option.
      </p>
      <p class="fine" style="margin-top: 0.7rem">
        Liability. Playing and using the equipment is at the guest’s own risk. Lead the Way Logistics & IT LLC and Team Battle Ready are not liable for injury, property damage, or loss from the rental except where the law requires it. A parent or guardian is responsible for minors. Guests follow the house rules and take care of the gear.
      </p>
      <p class="fine" style="margin-top: 0.7rem">
        A date is held when you call or text (254) 251-5219. Sponsor on the launch flyer:
        {site.sponsor}. No other sponsors are listed here.
      </p>
    </div>
    <div>
      <p class="eyebrow">On this site</p>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/book">Request a date</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/policies">Policies</a></li>
        <li><a href="/areas/killeen">Killeen</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow">Find the crew</p>
      <ul class="footer-links">
        {site.instagram.map((account) => (
          <li>
            <a href={account.href} rel="noopener noreferrer">{account.handle}</a>
          </li>
        ))}
      </ul>
      <p class="fine" style="margin-top: 0.8rem">
        Primary {site.instagram[0].handle}. Also {site.instagram[1].handle}.
      </p>
      <p class="fine" style="margin-top: 0.8rem">Phone: {phoneLabel()}</p>
      {site.contactEmail && (
        <p class="fine">
          Email: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </p>
      )}
      <p class="fine" style="margin-top: 0.8rem">{site.domain}</p>
    </div>
  </div>
  <div class="wrap" style="margin-top: 2rem">
    <p class="fine">© {new Date().getFullYear()} Team Battle Ready. Play. Connect. Build. Belong.</p>
  </div>
</footer>
