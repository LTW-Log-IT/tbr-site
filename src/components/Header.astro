---
import CallToBook from "./CallToBook.astro";
import { moreNav, primaryNav, site } from "../config/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function current(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}

const moreCurrent = moreNav.some((item) => current(item.href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo-lockup" href="/" aria-label="Team Battle Ready, home">
      <img class="brand-logo brand-logo-header" src={site.logo.chrome} alt="" width="2096" height="944" />
      <span class="logo-words">
        <span class="logo-name metal">Team Battle Ready</span>
        <span class="logo-sub">Gaming Trailer</span>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <div class="nav-more">
        <button
          class="nav-more-btn"
          type="button"
          aria-expanded="false"
          aria-controls="more-menu"
          aria-current={moreCurrent ? "page" : undefined}
        >
          More
        </button>
        <div id="more-menu" class="nav-more-panel" hidden>
          {
            moreNav.map((item) => (
              <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      <CallToBook />
    </nav>
    <div class="header-book">
      <CallToBook />
    </div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      Menu
    </button>
  </div>
  <div id="site-menu" class="mobile-panel" hidden>
    <nav aria-label="Mobile">
      <a href="/" aria-current={current("/") ? "page" : undefined}>Home</a>
      {
        primaryNav.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      {
        moreNav.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="/book">Book</a>
      <a href="/policies">Policies</a>
      <a href="tel:+12542515219">Call / Text to book</a>
      {
        site.instagram.map((account) => (
          <a href={account.href} rel="noopener noreferrer">
            {account.handle}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#site-menu");
  const moreButton = document.querySelector<HTMLButtonElement>(".nav-more-btn");
  const moreMenu = document.querySelector<HTMLElement>("#more-menu");

  const closeMobile = () => {
    if (!button || !menu) return;
    menu.hidden = true;
    button.setAttribute("aria-expanded", "false");
    button.textContent = "Menu";
    document.body.classList.remove("menu-open");
  };

  const closeMore = () => {
    if (!moreButton || !moreMenu) return;
    moreMenu.hidden = true;
    moreButton.setAttribute("aria-expanded", "false");
  };

  if (button && menu) {
    button.addEventListener("click", () => {
      const open = menu.hidden;
      closeMore();
      menu.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      button.textContent = open ? "Close" : "Menu";
      document.body.classList.toggle("menu-open", open);
    });
    menu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMobile();
    });
  }

  if (moreButton && moreMenu) {
    moreButton.addEventListener("click", () => {
      const open = moreMenu.hidden;
      moreMenu.hidden = !open;
      moreButton.setAttribute("aria-expanded", String(open));
    });
    moreMenu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) closeMore();
    });
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;
      if (!moreButton.contains(event.target) && !moreMenu.contains(event.target)) closeMore();
    });
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMobile();
      closeMore();
    }
  });
</script>
