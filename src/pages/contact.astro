---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { phoneLabel, site } from "../config/site";
import { packages, towns } from "../data/pricing";
---

<BaseLayout
  title="Contact Team Battle Ready | Killeen Gaming Trailer"
  description="Text or call (254) 251-5219, or send a quote request for the Team Battle Ready gaming trailer in Killeen and Fort Cavazos."
>
  <PageHero eyebrow="Contact" title="Text, call, or send the date." crumb="Contact">
    <p>
      Call or text (254) 251-5219 to book. <a href="/book">Request a date</a> if you would rather send the details. Units and schools that need an invoice can use the form. Nothing emails until an inbox exists.
    </p>
  </PageHero>

  <section class="section" style="padding-top: 0.5rem">
    <div class="wrap grid gap-6 lg:grid-cols-2">
      <div class="grid gap-4">
        <article class="panel" id="text">
          <h2 class="metal" style="font-size: 1.8rem">Text</h2>
          <p style="margin-top: 0.7rem"><a class="btn btn-primary" href={`sms:+${site.phoneE164}`}>Text {phoneLabel()}</a></p>
          <p class="muted" style="margin-top: 0.7rem">
            Copy if you need it: “Hi Team Battle Ready — I want to check a date for a gaming trailer in [town]. Package: [Skirmish / Mission / Campaign / 6-hour / 8-hour].”
          </p>
        </article>
        <article class="panel" id="call">
          <h2 class="metal" style="font-size: 1.8rem">Call</h2>
          <p style="margin-top: 0.7rem"><a class="btn btn-primary" href={`tel:+${site.phoneE164}`}>Call {phoneLabel()}</a></p>
        </article>
        <article class="panel" id="instagram">
          <h2 class="metal" style="font-size: 1.8rem">Instagram</h2>
          <p style="margin-top: 0.7rem">
            <a class="btn btn-primary" href={site.instagram[0].href} rel="noopener noreferrer">{site.instagram[0].handle}</a>
          </p>
          <p class="muted" style="margin-top: 0.7rem">
            Also <a class="inline-link" href={site.instagram[1].href} rel="noopener noreferrer">{site.instagram[1].handle}</a>.
          </p>
        </article>
        {site.contactEmail && (
          <article class="panel" id="email">
            <h2 class="metal" style="font-size: 1.8rem">Email</h2>
            <p class="muted" style="margin-top: 0.7rem">
              <a class="inline-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
            </p>
          </article>
        )}
      </div>

      <form id="quote-form" class="panel grid gap-4">
        <h2 class="metal" style="font-size: 1.8rem">Quote request</h2>
        <label>
          Name
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          Email
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          Phone
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label>
          Organization
          <input name="org" autocomplete="organization" />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Town
            <select name="town">
              {towns.map((town) => <option value={town.name}>{town.name}</option>)}
              <option value="Past 60 miles">Past 60 miles</option>
            </select>
          </label>
          <label>
            Headcount
            <input name="headcount" inputmode="numeric" />
          </label>
        </div>
        <label>
          Date options
          <input name="dates" placeholder="Two or three dates if you have them" />
        </label>
        <label>
          Package
          <select name="pkg">
            <option value="Not sure">Not sure yet</option>
            {packages.map((pkg) => <option value={`${pkg.name} ${pkg.timeLabel}`}>{pkg.name} · {pkg.timeLabel}</option>)}
          </select>
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Purchase order?
            <select name="po">
              <option>Not sure</option>
              <option>Yes</option>
              <option>No</option>
            </select>
          </label>
          <label>
            Tax-exempt certificate?
            <select name="tax">
              <option>Not sure</option>
              <option>Yes, we can send it</option>
              <option>No</option>
            </select>
          </label>
        </div>
        <label>
          Notes
          <textarea name="notes" placeholder="Parking limits, ages, invoice contact"></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Prepare this quote</button>
        <p class="status" id="quote-status" role="status"></p>
        <label id="quote-preview-label" hidden>
          Message to copy
          <textarea id="quote-preview" readonly></textarea>
        </label>
      </form>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ contactEmail: site.contactEmail }}>
  const form = document.querySelector("#quote-form");
  const status = document.querySelector("#quote-status");
  const preview = document.querySelector("#quote-preview");
  const previewLabel = document.querySelector("#quote-preview-label");
  if (form instanceof HTMLFormElement && status && preview instanceof HTMLTextAreaElement && previewLabel instanceof HTMLElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const lines = [];
      for (const [key, value] of data.entries()) {
        if (typeof value === "string" && value.trim()) lines.push(`${key}: ${value.trim()}`);
      }
      const body = lines.join("\n");
      previewLabel.hidden = false;
      preview.value = body;
      if (!contactEmail) {
        status.textContent = "This message was not emailed. Call or text (254) 251-5219. The note is in the box if you want to copy it.";
        return;
      }
      const subject = encodeURIComponent("Team Battle Ready quote");
      window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${encodeURIComponent(body)}`;
      status.textContent = "Your email app should open with this quote. If it does not, copy the box.";
    });
  }
</script>
