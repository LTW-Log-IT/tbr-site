---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { phoneLabel, site } from "../config/site";
import { partyPackages, startWindows, towns } from "../data/pricing";
---

<BaseLayout
  title="Rent the trailer | Team Battle Ready"
  description="Call or text (254) 251-5219 to rent the Team Battle Ready gaming trailer. The contact form is for rental interest only."
>
  <PageHero eyebrow="Rent the trailer" title="Call, text, or send a rental request." crumb="Contact">
    <p>
      Call or text {phoneLabel()} to hold a date. The form is rental interest only. It does not hold the trailer, and it is not the community list. {site.constructionNote} Community signups go to <a href="/join">Join TBR</a>.
    </p>
  </PageHero>

  <section class="section" style="padding-top: 0.5rem">
    <div class="wrap grid gap-6 lg:grid-cols-2">
      <div class="grid gap-4">
        <article class="panel" id="text">
          <h2 class="metal card-title">Text</h2>
          <p style="margin-top: 0.7rem"><a class="btn btn-primary" href={`sms:+${site.phoneE164}`}>Text {phoneLabel()}</a></p>
          <p class="muted" style="margin-top: 0.7rem">
            Copy if you need it: “Hi Team Battle Ready — I want to check a date for a gaming trailer in [town]. Package: [Skirmish / Mission / Campaign / 6-hour / 8-hour].”
          </p>
        </article>
        <article class="panel" id="call">
          <h2 class="metal card-title">Call</h2>
          <p style="margin-top: 0.7rem"><a class="btn btn-primary" href={`tel:+${site.phoneE164}`}>Call {phoneLabel()}</a></p>
        </article>
        <article class="panel" id="instagram">
          <h2 class="metal card-title">Instagram</h2>
          <p style="margin-top: 0.7rem">
            <a class="btn btn-primary" href={site.instagram[0].href} rel="noopener noreferrer">{site.instagram[0].handle}</a>
          </p>
          <p class="muted" style="margin-top: 0.7rem">
            Also <a class="inline-link" href={site.instagram[1].href} rel="noopener noreferrer">{site.instagram[1].handle}</a>.
          </p>
        </article>
        {site.contactEmail && (
          <article class="panel" id="email">
            <h2 class="metal card-title">Email</h2>
            <p class="muted" style="margin-top: 0.7rem">
              <a class="inline-link" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
            </p>
          </article>
        )}
      </div>

      <form
        id="rental-interest"
        class="lead-form panel grid gap-4"
        data-lead="rental"
        data-endpoint={site.forms.rental}
        data-email={site.contactEmail}
        data-sms={site.phoneE164}
      >
        <p class="eyebrow">Rental interest</p>
        <h2 class="metal card-title">Rent the trailer</h2>
        <p class="muted">Booking interest only. Call or text still holds the date. {site.constructionNote}</p>
        <input type="hidden" name="form_id" value="rental" />
        <input type="hidden" name="_subject" value="TBR trailer rental interest" />
        <label>
          Name
          <input name="name" autocomplete="name" required />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Phone
            <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </label>
          <label>
            Email
            <input name="email" type="email" autocomplete="email" />
          </label>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Preferred date
            <input name="preferred_date" type="date" />
          </label>
          <label>
            Preferred time
            <select name="preferred_time">
              <option value="">Not sure</option>
              {startWindows.map((window) => <option value={window.label}>{window.label}</option>)}
            </select>
          </label>
        </div>
        <label>
          Package interest
          <select name="package">
            <option value="Not sure">Not sure yet</option>
            {partyPackages.map((pkg) => <option value={`${pkg.name} ${pkg.timeLabel}`}>{pkg.name} · {pkg.timeLabel}</option>)}
          </select>
        </label>
        <label>
          City
          <select name="city">
            {towns.map((town) => <option value={town.name}>{town.name}</option>)}
            <option value="Outside the usual area">Outside the usual area</option>
          </select>
        </label>
        <label>
          Driveway parking
          <select name="driveway">
            <option value="Not sure yet">Not sure yet</option>
            <option value="Yes, driveway or side street can fit the truck and trailer">Yes, driveway or side street can fit the truck and trailer</option>
            <option value="No, we need another option">No, we need another option</option>
          </select>
        </label>
        <label>
          Notes
          <textarea name="notes" placeholder="Ages, a second date, or a school or church group"></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send rental interest</button>
        <p class="status" data-lead-status role="status"></p>
        <label data-lead-preview-label hidden>
          Message to copy
          <textarea data-lead-preview readonly></textarea>
        </label>
      </form>
    </div>
  </section>
</BaseLayout>
