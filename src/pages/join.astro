---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

const interests = ["Tournaments", "Events", "Casual play", "Giveaways"];
const cities = ["Killeen", "Copperas Cove", "Harker Heights", "Nolanville", "Other"];

const perks = [
  {
    title: "Tournaments",
    body: "Bring a tag and get in a match. Brackets for the nights that are about competing.",
  },
  {
    title: "Gaming events",
    body: "Nights built to play together. One room, a bunch of games, people who actually showed up.",
  },
  {
    title: "Member discounts",
    body: "This list hears about them first. Renting the trailer is still a separate booking at the posted price.",
  },
  {
    title: "Free giveaways",
    body: "When something is free, it goes to people on this list. Watch the Instagram for the drop.",
  },
];
---

<BaseLayout
  title="Join the Team Battle Ready Community"
  description="Join the Team Battle Ready gaming community for tournaments, gaming events, member discounts, and free giveaways. This list does not book the trailer."
>
  <section class="join-hero">
    <div class="wrap">
      <div class="hero-frame">
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
        <div class="speed-stack" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="eyebrow">Play · Compete · Belong</p>
        <h1 class="metal">Join the Team Battle Ready Community!</h1>
        <p class="lede">
          Tournaments. Game nights. Member discounts. Free giveaways. Play, compete, and bring the family.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#join-form">Get on the list</a>
        </div>
        <ul class="value-row">
          {site.values.map((value) => <li>{value}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 1.5rem" aria-label="What you get">
    <div class="wrap grid gap-4 md:grid-cols-2">
      {perks.map((perk) => (
        <article class="panel perk">
          <p class="eyebrow">{perk.title}</p>
          <h2 class="metal" style="font-size: 1.85rem">{perk.title}</h2>
          <p class="muted" style="margin-top: 0.55rem">{perk.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="join-form" style="padding-top: 0.5rem">
    <div class="wrap grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="eyebrow">Your tags</p>
        <h2 class="metal">Put your name on the list.</h2>
        <p class="lede">
          Xbox, Fortnite, or whatever you actually play. This is the community list. It does not rent the trailer.
        </p>
        <p class="muted" style="margin-top: 1rem">
          {site.constructionNote} For a trailer date, <a class="inline-link" href="/book">book</a> or <a class="inline-link" href="/contact">contact</a>.
        </p>
      </div>
      <form
        id="join-tbr"
        class="lead-form panel grid gap-4"
        data-lead="join"
        data-endpoint={site.forms.join}
        data-email={site.contactEmail}
        data-sms={site.phoneE164}
      >
        <input type="hidden" name="form_id" value="join" />
        <input type="hidden" name="_subject" value="TBR community join" />
        <label>
          Name
          <input name="name" autocomplete="name" required />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Email
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            Phone
            <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
          </label>
        </div>
        <label>
          Instagram handle
          <input name="instagram" placeholder="@name" autocomplete="off" />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Xbox gamertag
            <input name="xbox_gamertag" autocomplete="off" />
          </label>
          <label>
            Fortnite name
            <input name="fortnite" autocomplete="off" />
          </label>
        </div>
        <label>
          Other tags
          <input name="other_tags" placeholder="PSN, Switch, Discord" autocomplete="off" />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Age range
            <select name="age_range">
              <option value="">Prefer not to say</option>
              <option>Under 13</option>
              <option>13–17</option>
              <option>18+</option>
            </select>
          </label>
          <label>
            City
            <select name="city">
              <option value="">Not sure</option>
              {cities.map((city) => <option value={city}>{city}</option>)}
            </select>
          </label>
        </div>
        <label>
          Guardian note
          <textarea name="guardian_note" placeholder="If a minor is joining, a parent or guardian can leave a name and phone here."></textarea>
        </label>
        <fieldset class="checks-field">
          <legend>Interests</legend>
          {interests.map((interest) => (
            <label class="checkline">
              <input type="checkbox" name="interests" value={interest} />
              <span>{interest}</span>
            </label>
          ))}
        </fieldset>
        <button class="btn btn-primary" type="submit">Get on the list</button>
        <p class="status" data-lead-status role="status"></p>
        <label data-lead-preview-label hidden>
          Message to copy
          <textarea data-lead-preview readonly></textarea>
        </label>
      </form>
    </div>
  </section>
</BaseLayout>
