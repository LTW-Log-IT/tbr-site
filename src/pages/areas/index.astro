---
import CallToBook from "../../components/CallToBook.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { BEYOND_30_NOTE, SERVICE_AREA_NOTE, feeLabel, towns, zoneFor, zones } from "../../data/pricing";
---

<BaseLayout
  title="Service Area | Team Battle Ready Gaming Trailer"
  description="The usual area is Killeen, Copperas Cove, Harker Heights, and Nolanville. Travel there is free. Other towns are by exception only."
>
  <PageHero eyebrow="Where we go" title="Killeen, Copperas Cove, Harker Heights, and Nolanville." crumb="Areas">
    <p>
      {SERVICE_AREA_NOTE} Most bookings are a driveway in those cities. {BEYOND_30_NOTE}
    </p>
  </PageHero>

  <section class="section" style="padding-top: 1rem">
    <div class="wrap">
      <div class="table-wrap">
        <table class="data">
          <caption>The usual cities are within about 30 miles of Killeen. Outside that area there is no published fee.</caption>
          <thead>
            <tr>
              <th scope="col">Band</th>
              <th scope="col">One-way</th>
              <th scope="col">Fee</th>
            </tr>
          </thead>
          <tbody>
            {zones.map((zone) => (
              <tr>
                <th scope="row">{zone.name}</th>
                <td>{zone.miles}</td>
                <td>{feeLabel(zone.fee)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap grid gap-4 md:grid-cols-2">
      {towns.map((town) => {
        const zone = zoneFor(town.zoneId);
        return (
          <article class="panel" id={town.id}>
            <p class="eyebrow">{zone.name} · {feeLabel(town.fee)}</p>
            <h2 class="metal" style="font-size: 2rem">{town.name}</h2>
            <p class="muted" style="margin-top: 0.5rem">{town.blurb}</p>
            {town.href && (
              <p style="margin-top: 0.8rem">
                <a class="inline-link" href={town.href}>Killeen city page</a>
              </p>
            )}
          </article>
        );
      })}
    </div>
    <div class="wrap" style="margin-top: 1.5rem">
      <CallToBook />
    </div>
  </section>
</BaseLayout>
