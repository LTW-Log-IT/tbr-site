---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CallToBook from "../components/CallToBook.astro";
import { site } from "../config/site";

const flyerPerks = [
  "Free decals and windshield banners",
  "Sponsorship opportunities",
  "Discounts at various shops",
  "Events, meets, and cruises",
  "Community, networking, and support",
];
---

<BaseLayout
  title="About Team Battle Ready | Killeen Car Club and Gaming Trailer"
  description="Team Battle Ready is a Central Texas car club and a mobile gaming trailer for birthdays, BBQs, and game nights in Killeen and Fort Hood."
>
  <PageHero eyebrow="About" title="Car club and gaming trailer." crumb="About">
    <p>
      Team Battle Ready is Joe Bonilla’s car club in Central Texas, and a gaming trailer for birthdays, BBQs, and game nights around Killeen and Fort Hood.
    </p>
  </PageHero>

  <article class="section" style="padding-top: 0.5rem">
    <div class="wrap grid gap-8 lg:grid-cols-2">
      <div class="prose">
        <h2>The club and the trailer</h2>
        <p>
          The trailer is a mobile game room with 6 dedicated gaming stations. A game coach stays on site for the whole booking, and Wi-Fi is available for online multiplayer. People book it for birthdays, BBQs, game nights, and family days. The club is meets and cruises. Booking the trailer does not sign you up for the club. Following the club does not reserve the trailer.
        </p>
        <p>{site.constructionNote} {site.climateNote}</p>
        <h2>Youth events</h2>
        <p>
          Youth events are planned with a second adult on site.
        </p>
      </div>
      <div>
        <div class="poster">
          <p class="eyebrow">B4TTL3 · Central Texas car club</p>
          <p class="poster-title metal">Team Battle Ready</p>
          <img class="brand-logo brand-logo-plate" src={site.logo.plate} alt="B4TTL3" width="2096" height="944" />
          <ul class="poster-values">
            {site.values.map((value) => <li>{value}</li>)}
          </ul>
          <p class="poster-sponsor">{site.tagline}</p>
        </div>
        <div class="panel" style="margin-top: 0.8rem">
          <h2 class="metal card-title">From the launch flyer</h2>
          <p class="muted" style="margin-top: 0.5rem">Member benefits the flyer lists for the car club. These perks are not included with a trailer booking.</p>
          <ul class="checks">
            {flyerPerks.map((perk) => <li>{perk}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="wrap prose" style="margin-top: 2rem">
      <h2>Find us</h2>
      <p>
        Team Battle Ready is a <a href={site.parent.href} rel="noopener noreferrer">Lead the Way Logistics & IT</a> offering.
        The gaming community list is on <a href="/join">Join TBR</a>. Trailer rental stays on <a href="/contact">Contact</a>.
      </p>
      <p>
        Instagram: {site.instagram.map((account, index) => (
          <>
            <a href={account.href} rel="noopener noreferrer">{account.handle}</a>
            {index === 0 ? " and " : ""}
          </>
        ))}.
      </p>
      <p><CallToBook /></p>
    </div>
  </article>
</BaseLayout>
