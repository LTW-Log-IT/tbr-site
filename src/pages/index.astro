---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import DateCheck from "../components/DateCheck.astro";
import FaqList from "../components/FaqList.astro";
import PackageCard from "../components/PackageCard.astro";
import CallToBook from "../components/CallToBook.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { site, textHref } from "../config/site";
import { homeFaqs, faqSchema } from "../data/faq";
import { partyPackages } from "../data/pricing";
import { localBusinessSchema } from "../lib/schema";

const hasFlyer = fs.existsSync(path.join(process.cwd(), "public/brand/tbr-flyer-launch.png"));
const text = textHref();

const steps = [
  {
    n: "01",
    title: "Check the date",
    body: "Pick a package, a town, and a start window. Travel is free in Killeen, Copperas Cove, Harker Heights, and Nolanville. Anywhere else needs approval before the date.",
  },
  {
    n: "02",
    title: "Leave the deposit",
    body: "A flat $100 holds the date. That hold is what keeps one trailer from getting booked twice.",
  },
  {
    n: "03",
    title: "We set up",
    body: "Level ground, the 13.5 kW generator on, cabin cooled. The trailer is unwrapped. Magnets or a banner are fine.",
  },
  {
    n: "04",
    title: "Play",
    body: "Six gaming stations, each with a monitor, a chair, and a console (Xbox Series S/X, PS5, or Switch). Add-ons are extra.",
  },
];
---

<BaseLayout
  title="The Party Shows Up Battle Ready | Team Battle Ready"
  description="Mobile video game theater for up to 24 players in Killeen, Copperas Cove, Harker Heights, and Nolanville. Skirmish from $349 on weekdays. The trailer is still under construction, so rental dates are limited."
  jsonLd={[localBusinessSchema(), faqSchema(homeFaqs)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
    <div class="hero-frame">
      <span class="corner tl" aria-hidden="true"></span>
      <span class="corner tr" aria-hidden="true"></span>
      <span class="corner bl" aria-hidden="true"></span>
      <span class="corner br" aria-hidden="true"></span>
      <div class="speed-stack" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="eyebrow">Killeen · Copperas Cove · Harker Heights · Nolanville</p>
      <h1 class="metal">The Party Shows Up Battle Ready.</h1>
      <img class="brand-logo brand-logo-hero" src={site.logo.chrome} alt="B4TTL3" width="2096" height="944" />
      <p class="lede">
        Mobile video game theater for up to 24 players. Killeen, Copperas Cove, Harker Heights, and Nolanville.
      </p>
      <p class="muted">{site.constructionNote}</p>
      <div class="hero-actions">
        <CallToBook />
        <a class="btn btn-ghost" href={text}>Text Us</a>
      </div>
      <ul class="value-row">
        {site.values.map((value) => <li>{value}</li>)}
      </ul>
    </div>
    <PhotoPlaceholder caption="Trailer photos coming soon." />
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-label="What you can count on">
    <div class="wrap">
      <ul class="trust">
        <li>Up to 24 players</li>
        <li>Climate-controlled cabin</li>
        <li>Free in four cities</li>
        <li>$100 deposit</li>
        <li>14+ days: full refund</li>
        <li>$25 military, responder, teacher</li>
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="check-title">
    <div class="wrap">
      <p class="eyebrow">Date check</p>
      <h2 id="check-title" class="metal">See if the town is in the usual area.</h2>
      <p class="lede">A date is held when you call or text (254) 251-5219. This form only carries the package and town to the request page.</p>
      <div style="margin: 1rem 0 1.25rem">
        <CallToBook />
      </div>
      <div style="margin-top: 1.25rem">
        <DateCheck />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="packages-title">
    <div class="wrap">
      <p class="eyebrow">Rate card</p>
      <h2 id="packages-title" class="metal">Skirmish, Mission, Campaign.</h2>
      <p class="lede">The big number is Monday–Thursday. Friday–Sunday is on the line under it. Full days are 6 and 8 hours. Home parties use these packages.</p>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" style="margin-top: 1.5rem">
        {partyPackages.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
      <p class="muted" style="margin-top: 1rem">
        <a class="inline-link" href="/packages">Full comparison, add-ons, and travel.</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="how-title">
    <div class="wrap">
      <p class="eyebrow">How booking works</p>
      <h2 id="how-title" class="metal">Four steps.</h2>
      <div class="steps" style="margin-top: 1.5rem">
        {steps.map((step) => (
          <article class="panel step">
            <p class="step-no">{step.n}</p>
            <div>
              <h3 class="metal">{step.title}</h3>
              <p class="muted" style="margin-top: 0.4rem">{step.body}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="muted" style="margin-top: 1rem">
        On the trailer now: 6 gaming stations, each with a gaming monitor, a gaming chair, and a console (Xbox Series S/X, PS5, or Nintendo Switch). Also about 4 Xbox, 3 PS5s, and 8 eight-inch tablets for Roblox and Minecraft, plus various games. Monitor sizes and the measured parking length are still open on <a class="inline-link" href="/the-rig">The Rig</a>.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="crossover-title">
    <div class="wrap grid gap-6 lg:grid-cols-2 lg:items-stretch">
      <div>
        <p class="eyebrow">Car club</p>
        <h2 id="crossover-title" class="metal">The club and the trailer.</h2>
        <div class="prose" style="margin-top: 1rem">
          <p>
            Team Battle Ready is a Central Texas car club with a gaming trailer. Meets and cruises are the club. Birthdays, BBQs, and game nights are the trailer.
          </p>
          <p>
            Follow the cars and the trailer at {site.instagram.map((account, index) => (
              <>
                <a href={account.href} rel="noopener noreferrer">{account.handle}</a>
                {index === 0 ? " and " : ""}
              </>
            ))}.
          </p>
          <p>
            Club perks on the launch flyer — decals, shop discounts, meets, cruises — are for the car club, not a trailer booking. Membership signups are not on this site. Instagram is where the club posts.
          </p>
        </div>
      </div>
      <div class="poster">
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
        {hasFlyer && (
          <img
            src="/brand/tbr-flyer-launch.png"
            alt="Launch flyer for Team Battle Ready. Metallic silver wordmark, cyan B4TTL3 mark, and night asphalt."
            style="margin-bottom: 1rem"
          />
        )}
        <div class="speed-stack" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="eyebrow">B4TTL3 · Central Texas</p>
        <p class="poster-title metal">Team Battle Ready</p>
        <img class="brand-logo brand-logo-plate" src={site.logo.plate} alt="B4TTL3" width="2096" height="944" />
        <ul class="poster-values">
          {site.values.map((value) => <li>{value}</li>)}
        </ul>
        <p class="poster-sponsor">{site.tagline}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="groups-title">
    <div class="wrap">
      <p class="eyebrow">Families and groups</p>
      <h2 id="groups-title" class="metal">Family days in Killeen, Cove, Harker Heights, and Nolanville.</h2>
      <div class="band-grid" style="margin-top: 1.25rem">
        <a class="band-card" href="/military">
          <h3 class="metal">Thank you for your service</h3>
          <p class="muted">Discounts for active duty and veterans. $25 off once for military, first responders, and teachers with an ID. Discounts do not stack. Travel and add-ons stay full price. Most bookings are a driveway in Killeen, Copperas Cove, Harker Heights, or Nolanville.</p>
        </a>
        <a class="band-card" href="/military#groups">
          <h3 class="metal">Schools and organizations</h3>
          <p class="muted">Verified organizations only. Six- and eight-hour full days, or $125 an hour Monday–Thursday with a 3-hour minimum. Not a home-party price.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="metal">Common questions.</h2>
      <div style="margin-top: 1rem">
        <FaqList items={homeFaqs} />
      </div>
      <p style="margin-top: 1rem"><a class="btn btn-ghost" href="/faq">All questions</a></p>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <div class="wrap">
      <div class="slash">
        <p>Call or text (254) 251-5219 to hold the date.</p>
      </div>
      <h2 id="final-title" class="metal" style="margin-top: 1.5rem">The trailer holds one booking at a time.</h2>
      <p class="lede">Killeen, Copperas Cove, Harker Heights, and Nolanville are the usual area. Other towns are by exception.</p>
      <div class="cta-row">
        <CallToBook />
        <a class="btn btn-ghost" href={text}>Text Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
