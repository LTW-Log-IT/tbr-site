---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingSteps from "../components/BookingSteps.astro";
import CallToBook from "../components/CallToBook.astro";
import FaqList from "../components/FaqList.astro";
import PackageCard from "../components/PackageCard.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { site, textDateHref } from "../config/site";
import { faqSchema, homeFaqs } from "../data/faq";
import { partyPackages } from "../data/pricing";
import { localBusinessSchema } from "../lib/schema";

const headline = partyPackages.filter((pkg) =>
  pkg.id === "skirmish" || pkg.id === "mission" || pkg.id === "campaign",
);

const inside = [
  { title: "6 stations", body: "27-inch monitor, chair, and a console at each one." },
  { title: "Consoles", body: "Xbox Series S/X, PS5, or Switch. About 4 Xbox and 3 PS5s. Certain games are 4-player." },
  { title: "8 tablets", body: "Stand-alone 8-inch tablets for younger kids." },
  { title: "Attendant", body: "A game coach stays on site the whole booking." },
  { title: "Wi-Fi", body: "Online multiplayer is available." },
  { title: "Power", body: "Self-powered 13.5 kW generator. No outlet needed." },
];
---

<BaseLayout
  title="The Party Shows Up Battle Ready | Team Battle Ready"
  description="Play · Connect · Build · Belong. Gaming trailer parties start at $349 on weekdays in Killeen, Copperas Cove, Harker Heights, and Nolanville. The trailer is still under construction."
  jsonLd={[localBusinessSchema(), faqSchema(homeFaqs)]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-frame">
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
        <div class="speed-stack" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="metal">The Party Shows Up Battle Ready.</h1>
        <p class="price-callout"><span>Starts at</span> $349</p>
        <p class="lede">Weekday Skirmish, 2 hours. Friday–Sunday is $399. Prices exclude tax.</p>
        <p class="muted">{site.constructionNote}</p>
        <p class="muted" style="margin-top: 0.45rem">{site.climateNote}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/book">Book Now</a>
          <CallToBook />
          <a class="btn btn-ghost" href={textDateHref()}>Text us your date</a>
        </div>
        <p class="muted" style="margin-top: 0.9rem">
          <a class="inline-link" href="/join">Join the Team Battle Ready community</a>
        </p>
      </div>
      <PhotoPlaceholder caption="Photos coming soon — trailer under construction." mark="Photos coming soon" />
    </div>
    <div class="wrap" style="margin-top: 2rem">
      <p class="eyebrow">How booking works</p>
      <h2 id="how-title" class="metal">Text the date. We confirm. $100 holds it.</h2>
      <div style="margin-top: 1.25rem">
        <BookingSteps />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="packages-title">
    <div class="wrap">
      <p class="eyebrow">Packages</p>
      <h2 id="packages-title" class="metal">Skirmish, Mission, Campaign.</h2>
      <p class="lede">Monday–Thursday is the big number. Friday–Sunday is the line under it.</p>
      <div class="grid gap-4 md:grid-cols-3" style="margin-top: 1.25rem">
        {headline.map((pkg) => <PackageCard pkg={pkg} compact />)}
      </div>
      <p class="muted" style="margin-top: 1rem">
        <a class="inline-link" href="/packages">Full days, the group rate, and the comparison.</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="inside-title">
    <div class="wrap">
      <p class="eyebrow">What’s inside</p>
      <h2 id="inside-title" class="metal">The room that shows up.</h2>
      <ul class="inside-strip">
        {inside.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-label="Service area and discount">
    <div class="wrap">
      <p class="lede">
        Killeen, Copperas Cove, Harker Heights, and Nolanville. Other towns, including Fort Hood, are by exception.
        <a class="inline-link" href="/areas"> Areas.</a>
      </p>
      <p class="lede" style="margin-top: 0.8rem">
        Thank you for your service. Active duty, veterans, first responders, and teachers: $25 off once with an ID. Discounts do not stack.
        <a class="inline-link" href="/military"> Details.</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="metal">Before you text.</h2>
      <div style="margin-top: 1rem">
        <FaqList items={homeFaqs} />
      </div>
      <p style="margin-top: 1rem"><a class="btn btn-ghost" href="/faq">All questions</a></p>
    </div>
  </section>
</BaseLayout>
