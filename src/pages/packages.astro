---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PackageCard from "../components/PackageCard.astro";
import CallToBook from "../components/CallToBook.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import { site } from "../config/site";
import {
  BEYOND_30_NOTE,
  SERVICE_AREA_NOTE,
  COMMUNITY_DISCOUNT,
  DEPOSIT,
  EXTRA_HALF_HOUR,
  GROUP_HOURLY,
  GROUP_MIN_HOURS,
  addons,
  feeLabel,
  groupPackage,
  money,
  partyPackages,
  towns,
  zones,
} from "../data/pricing";

const matrix = [
  { label: "Time", value: (id: string) => partyPackages.find((p) => p.id === id)!.timeLabel },
  {
    label: "Monday–Thursday",
    value: (id: string) => money(partyPackages.find((p) => p.id === id)!.weekdayPrice),
  },
  {
    label: "Friday–Sunday",
    value: (id: string) => money(partyPackages.find((p) => p.id === id)!.weekendPrice ?? 0),
  },
  { label: "Stations", value: () => "6 dedicated, 27-inch monitors" },
  { label: "Multiplayer", value: () => "Certain 4-player games" },
  { label: "Attendant, setup, teardown", value: () => "On site the whole booking" },
  { label: "Wi-Fi", value: () => "Online multiplayer" },
  { label: "Xbox / PS5 / tablets", value: () => "About 4 / 3 / 8 stand-alone 8-inch" },
  { label: "Toddler zone", value: () => `Add-on ${money(75)}` },
  { label: "Tournament pack", value: () => `Add-on ${money(40)}` },
  { label: "Yard games", value: () => `Add-on ${money(25)}` },
  { label: "Dog-tag favors", value: () => `Add-on ${money(30)}, flat` },
];
---

<BaseLayout
  title="Packages and Pricing | Team Battle Ready Gaming Trailer"
  description="Skirmish $349/$399, Mission $449/$499, Campaign $549/$599. Six- and eight-hour full days. Home parties use those packages. Verified organizations have a separate weekday hourly rate. Quotes add 8.25% tax."
>
  <PageHero eyebrow="Rate card" title="Packages and prices." crumb="Packages">
    <p>
      Weekday means Monday–Thursday. Weekend means Friday–Sunday. Prices exclude tax. The quote adds 8.25%.
    </p>
  </PageHero>

  <section class="section" style="padding-top: 1.5rem">
    <div class="wrap">
      <h2 class="metal">Skirmish, Mission, Campaign</h2>
      <p class="lede">The first price is Monday–Thursday. The line under it is Friday–Sunday.</p>
      <div class="grid gap-4 md:grid-cols-2" style="margin-top: 1.25rem">
        <PhotoPlaceholder caption="Trailer photos coming soon. Package art stays typographic until the trailer is photographed." />
        <PhotoPlaceholder caption="Trailer photos coming soon. Unwrapped trailer. Magnets or a banner are fine. No wrap." />
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" style="margin-top: 1.25rem">
        {partyPackages.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
      <p class="muted" style="margin-top: 1rem">Extra time is {money(EXTRA_HALF_HOUR)} per 30 minutes, only if the next slot is open.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="included-title">
    <div class="wrap">
      <h2 id="included-title" class="metal">What’s included</h2>
      <ul class="checks" style="margin-top: 1rem">
        <li>Trailer arrival, setup, and teardown.</li>
        <li>6 dedicated stations, each with a 27-inch monitor, a chair, and a console (Xbox Series S/X, PS5, or Switch).</li>
        <li>About 4 Xbox, 3 PS5s, and 8 stand-alone 8-inch tablets.</li>
        <li>A game coach on site for the whole booking.</li>
        <li>Wi-Fi for online multiplayer. Certain games are 4-player.</li>
        <li>Self-powered 13.5 kW generator. No outlet needed.</li>
      </ul>
      <p class="muted" style="margin-top: 0.8rem">{site.constructionNote} {site.climateNote}</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="events-title">
    <div class="wrap">
      <h2 id="events-title" class="metal">Birthdays, schools, and family days.</h2>
      <div class="event-grid" style="margin-top: 1.25rem">
        <article class="panel">
          <h3 class="metal">Birthdays</h3>
          <p class="muted" style="margin-top: 0.55rem">A driveway or side street at the house. Skirmish starts at $349 on a weekday.</p>
        </article>
        <article class="panel">
          <h3 class="metal">Schools and churches</h3>
          <p class="muted" style="margin-top: 0.55rem">Same trailer, parked where it can legally sit. Verified organizations can ask about the weekday hourly rate. It is not a home-party price.</p>
        </article>
        <article class="panel">
          <h3 class="metal">Military, FRG, and corporate</h3>
          <p class="muted" style="margin-top: 0.55rem">Unit days, homecomings, and family days at a house or driveway. Fort Hood and other towns outside the four cities are by exception and quoted by text.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="compare-title">
    <div class="wrap">
      <h2 id="compare-title" class="metal">Compare them</h2>
      <div class="table-wrap" style="margin-top: 1rem">
        <table class="data">
          <caption>Weekday and weekend prices for each named package. Swipe sideways on a phone.</caption>
          <thead>
            <tr>
              <th scope="col"> </th>
              {partyPackages.map((pkg) => <th scope="col">{pkg.name} · {pkg.timeLabel}</th>)}
            </tr>
          </thead>
          <tbody>
            {matrix.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {partyPackages.map((pkg) => <td>{row.value(pkg.id)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="group-title">
    <div class="wrap">
      <p class="eyebrow">Schools, churches, units, nonprofits</p>
      <h2 id="group-title" class="metal">Verified organizations only</h2>
      <p class="lede">Not a birthday price and not a home-party alternative. Residential bookings stay on Skirmish, Mission, Campaign, or a full day.</p>
      <div class="grid gap-4 md:grid-cols-2" style="margin-top: 1.25rem">
        <PackageCard pkg={groupPackage} />
        <article class="panel">
          <p class="muted">
            {money(GROUP_HOURLY)} an hour, Monday–Thursday, {GROUP_MIN_HOURS}-hour minimum, for schools, churches, units, and nonprofits that can show a tax-exempt certificate or a purchase order.
            Friday, Saturday, and Sunday stay on Skirmish, Mission, Campaign, or a full day.
          </p>
          <p class="muted" style="margin-top: 0.8rem">
            The {money(COMMUNITY_DISCOUNT)} military, veteran, first responder, and teacher discount comes off the hourly total once, with an ID. Discounts do not stack.
            Travel and add-ons stay full price. The quote still adds 8.25% unless an exemption certificate is on file.
          </p>
          <p style="margin-top: 1rem"><CallToBook /></p>
          <p style="margin-top: 0.7rem"><a class="inline-link" href="/book?pkg=group">Request a date</a></p>
        </article>
      </div>
      <p class="muted" style="margin-top: 1rem">
        <a class="inline-link" href="/military">Military page</a>
        ·
        <a class="inline-link" href="/contact">Quote form</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="addon-title">
    <div class="wrap">
      <h2 id="addon-title" class="metal">Add-ons</h2>
      <div class="table-wrap" style="margin-top: 1rem">
        <table class="data">
          <caption>Add-on prices. Each one is a flat fee, not per guest.</caption>
          <thead>
            <tr>
              <th scope="col">Add-on</th>
              <th scope="col">Price</th>
              <th scope="col">Notes</th>
            </tr>
          </thead>
          <tbody>
            {addons.map((addon) => (
              <tr>
                <th scope="row">{addon.name}</th>
                <td>{money(addon.price)}</td>
                <td>{addon.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="travel-title">
    <div class="wrap">
      <h2 id="travel-title" class="metal">Travel from Killeen</h2>
      <p class="lede">
        {SERVICE_AREA_NOTE} {BEYOND_30_NOTE}
      </p>
      <div class="table-wrap" style="margin-top: 1rem">
        <table class="data">
          <caption>Travel is free in the four usual cities. Outside that area there is no published price.</caption>
          <thead>
            <tr>
              <th scope="col">Band</th>
              <th scope="col">Distance</th>
              <th scope="col">Fee</th>
              <th scope="col">Towns</th>
            </tr>
          </thead>
          <tbody>
            {zones.map((zone) => (
              <tr>
                <th scope="row">{zone.name}</th>
                <td>{zone.miles}</td>
                <td>{feeLabel(zone.fee)}</td>
                <td>{towns.filter((town) => town.zoneId === zone.id).map((town) => town.name).join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted" style="margin-top: 0.8rem">
        Most bookings are a driveway in Killeen, Copperas Cove, Harker Heights, or Nolanville. Travel outside those cities is not included in the package price.
        <a class="inline-link" href="/areas"> Town-by-town list.</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0" aria-labelledby="discount-title">
    <div class="wrap grid gap-6 lg:grid-cols-2">
      <div class="panel">
        <h2 id="discount-title" class="metal">Discount</h2>
        <ul class="checks" style="margin-top: 0.8rem">
          <li>Active duty, veteran, first responder, or teacher: {money(COMMUNITY_DISCOUNT)} off the package or the weekday hourly total. ID only.</li>
          <li>Discounts do not stack. One {money(COMMUNITY_DISCOUNT)} off per booking.</li>
        </ul>
        <p class="muted" style="margin-top: 0.8rem">Travel, add-ons, and extra time stay full price. Prices still exclude tax. Square charges the full package price. Call or text to apply the {money(COMMUNITY_DISCOUNT)}.</p>
      </div>
      <div class="panel">
        <h2 class="metal">Deposit and tax</h2>
        <div class="prose" style="margin-top: 0.8rem">
          <p>The deposit is a flat {money(DEPOSIT)} on every booking, paid on Square after we confirm the day.</p>
          <p>Listed prices exclude tax. The quote adds 8.25%.</p>
          <p>Cancellation, reschedule, and when the balance is due are not published yet. Confirm them by text when you book.</p>
          <p><a href="/policies">Policies</a></p>
        </div>
      </div>
    </div>
    <div class="wrap" style="margin-top: 1.5rem">
      <CallToBook />
    </div>
  </section>
</BaseLayout>
