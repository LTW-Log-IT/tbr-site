---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingSteps from "../components/BookingSteps.astro";
import CallToBook from "../components/CallToBook.astro";
import PageHero from "../components/PageHero.astro";
import { phoneLabel, site, squarePackageHref, textDateHref, textHref } from "../config/site";
import { addons, COMMUNITY_DISCOUNT, DEPOSIT, discounts, groupPackage, money, partyPackages, startWindows, towns } from "../data/pricing";

const squarePackages = partyPackages.flatMap((pkg) => {
  const rows: { href: string; name: string; when: string; price: number }[] = [];
  const weekday = squarePackageHref(pkg.id, "weekday");
  const weekend = squarePackageHref(pkg.id, "weekend");
  if (weekday) rows.push({ href: weekday, name: pkg.name, when: "Mon–Thu", price: pkg.weekdayPrice });
  if (weekend && pkg.weekendPrice != null) {
    rows.push({ href: weekend, name: pkg.name, when: "Fri–Sun", price: pkg.weekendPrice });
  }
  return rows;
});
---

<BaseLayout
  title="Call or Text to Book | Team Battle Ready Gaming Trailer"
  description="Book the Team Battle Ready gaming trailer by calling or texting (254) 251-5219. Pay the $100 deposit or a package with Square. Quotes add 8.25% tax."
>
  <PageHero eyebrow="Booking" title="Call / Text to book." crumb="Book">
    <p>
      Call or text {phoneLabel()} to hold the date. Joe will call you back. {site.constructionNote}
      The quote below adds 8.25% tax. The deposit is a flat {money(100)}. Listed prices exclude tax.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={textDateHref()}>Text us your date</a>
      <CallToBook />
    </div>
  </PageHero>

  <section class="section" style="padding-top: 0.25rem" aria-labelledby="how-title">
    <div class="wrap">
      <p class="eyebrow">How booking works</p>
      <h2 id="how-title" class="metal">Three steps.</h2>
      <div style="margin-top: 1.25rem">
        <BookingSteps />
      </div>
    </div>
  </section>

  <section class="section" id="pay" style="padding-top: 0.5rem" aria-labelledby="pay-title">
    <div class="wrap">
      <p class="eyebrow">Square</p>
      <h2 id="pay-title" class="metal">Pay with Square</h2>
      <p class="lede">
        Call or text {phoneLabel()} to hold the date. These links take the deposit or a package price and open in a new tab.
        Listed prices exclude tax. Square tax may be configured separately.
        These Square buttons charge the full package price. With an ID, active duty, veterans, first responders, and teachers get {money(COMMUNITY_DISCOUNT)} off once. Discounts do not stack. Travel and add-ons stay full price. Call or text {phoneLabel()} to apply the discount if Square cannot adjust it.
      </p>
      <ul class="checks" style="margin-top: 1rem">
        {partyPackages.filter((pkg) => pkg.weekendPrice != null).map((pkg) => (
          <li>
            {pkg.name} {pkg.timeLabel}: {money(pkg.weekdayPrice)} − {money(COMMUNITY_DISCOUNT)} = {money(pkg.weekdayPrice - COMMUNITY_DISCOUNT)} Mon–Thu
            · {money(pkg.weekendPrice ?? pkg.weekdayPrice)} − {money(COMMUNITY_DISCOUNT)} = {money((pkg.weekendPrice ?? pkg.weekdayPrice) - COMMUNITY_DISCOUNT)} Fri–Sun
          </li>
        ))}
      </ul>
      <p style="margin-top: 1.25rem">
        <a class="btn btn-primary" href={site.squareLinks.deposit} target="_blank" rel="noopener noreferrer">
          Pay deposit · {money(DEPOSIT)}
        </a>
      </p>
      <div class="pay-grid" style="margin-top: 1rem">
        {squarePackages.map((item) => (
          <a class="btn btn-ghost" href={item.href} target="_blank" rel="noopener noreferrer">
            Pay {item.name} · {item.when} · {money(item.price)}
          </a>
        ))}
      </div>
      <div class="prose" style="margin-top: 1.75rem">
        <h2>Parking</h2>
        <p>
          The truck and trailer need a driveway or a side street where they can legally park for the booking. Confirm that spot before the date. If parking will not work, call or text {phoneLabel()} and we will figure out another option.
        </p>
        <h2>Liability</h2>
        <p>
          Assumption of risk. Participation and use of the equipment are at the guest’s own risk. Lead the Way Logistics & IT LLC and Team Battle Ready are not liable for injury, property damage, or loss arising from the rental, except as required by law. A parent or guardian is responsible for minors. Guests follow the house rules and take care of the gear.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0.5rem" aria-labelledby="request-title">
    <div class="wrap grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <form
        id="request-date"
        class="lead-form panel grid gap-4"
        data-lead="rental"
        data-endpoint={site.forms.rental}
        data-email={site.contactEmail}
        data-sms={site.phoneE164}
      >
        <p class="eyebrow">Rental interest</p>
        <h2 id="request-title" class="metal" style="font-size: 2rem">Request a date</h2>
        <p class="muted">This does not hold the trailer. {phoneLabel()} does. Joining the community is a <a class="inline-link" href="/join">separate form</a>.</p>
        <input type="hidden" name="form_id" value="rental" />
        <input type="hidden" name="_subject" value="TBR trailer rental interest" />
        <label>
          Name
          <input id="req-name" name="name" autocomplete="name" required />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Phone
            <input id="req-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </label>
          <label>
            Email
            <input id="req-email" name="email" type="email" autocomplete="email" />
          </label>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Preferred date
            <input id="req-date" name="preferred_date" type="date" />
          </label>
          <label>
            Preferred time
            <select id="req-time" name="preferred_time">
              <option value="">Not sure</option>
              {startWindows.map((window) => <option value={window.label}>{window.label}</option>)}
            </select>
          </label>
        </div>
        <label>
          Package interest
          <select id="req-pkg" name="package">
            <option value="Not sure">Not sure yet</option>
            {partyPackages.map((pkg) => <option value={pkg.id}>{pkg.name} · {pkg.timeLabel}</option>)}
          </select>
        </label>
        <label>
          City
          <select id="req-city" name="city">
            {towns.map((town) => <option value={town.id}>{town.name}</option>)}
            <option value="outside">Outside the usual area</option>
          </select>
        </label>
        <label>
          Driveway parking
          <select name="driveway">
            <option value="Not sure yet">Not sure yet</option>
            <option value="Yes, driveway or side street can fit the truck and trailer">Yes, driveway or side street can fit the truck and trailer</option>
            <option value="No, we need another option">No, we need another option</option>
          </select>
        </label>
        <label>
          Notes
          <textarea id="req-notes" name="notes" placeholder="Ages, a second date, or a school or church group"></textarea>
        </label>
        <button class="btn btn-primary" type="submit">Send rental interest</button>
        <p class="status" data-lead-status role="status"></p>
        <label data-lead-preview-label hidden>
          Message to copy
          <textarea data-lead-preview readonly></textarea>
        </label>
      </form>
      <aside class="panel">
        <p class="eyebrow">The real path</p>
        <h2 class="metal" style="font-size: 2rem">We’ll text you back</h2>
        <p class="muted" style="margin-top: 0.7rem">
          Call or text {phoneLabel()}. If the request opens your text app, send it. If it does not, call. Joe will call you back.
        </p>
        <div class="cta-row">
          <CallToBook />
          <a class="btn btn-ghost" href={textHref()}>Text {phoneLabel()}</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top: 1rem">
    <div class="wrap grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <form id="planner" class="grid gap-4">
        <label>
          Package
          <select id="pkg" name="pkg">
            <optgroup label="Named packages">
              {partyPackages.map((pkg) => (
                <option value={pkg.id} selected={pkg.id === "mission"}>
                  {pkg.name} · {pkg.timeLabel} · {money(pkg.weekdayPrice)} weekdays / {money(pkg.weekendPrice ?? pkg.weekdayPrice)} weekends
                </option>
              ))}
            </optgroup>
            <optgroup label="Verified organizations only — not for home parties">
              <option value={groupPackage.id}>{groupPackage.name} · {groupPackage.timeLabel}</option>
            </optgroup>
          </select>
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Date
            <input id="date" name="date" type="date" />
          </label>
          <label>
            Start window
            <select id="time" name="time">
              {startWindows.map((window) => <option value={window.id}>{window.label}</option>)}
            </select>
          </label>
        </div>
        <p class="muted">Monday–Thursday and Friday–Sunday are different prices. This total is a quote, not a held date.</p>
        <label>
          Town
          <select id="town" name="town">
            {towns.map((town) => (
              <option value={town.id} selected={town.id === "killeen"}>{town.name}</option>
            ))}
            <option value="beyond">Outside the usual area</option>
          </select>
        </label>
        <p class="muted">Travel is free in Killeen, Copperas Cove, Harker Heights, and Nolanville, within about 30 miles of Killeen. Outside that area, trips are by exception only and have to be approved ahead of time. Prices vary. A 4-hour minimum may be required. That travel cost is not in this quote.</p>
        <div class="grid gap-4 md:grid-cols-2">
          <label>
            Organization hours
            <input id="hours" name="hours" type="number" min="3" max="12" value="3" inputmode="numeric" />
          </label>
          <label>
            Extra 30-minute blocks
            <input id="extra" name="extra" type="number" min="0" max="6" value="0" inputmode="numeric" />
          </label>
        </div>
        <p class="muted">Organization hours apply only to the verified-organization rate: schools, churches, units, and nonprofits with a tax-exempt certificate or a purchase order. Home parties ignore that field. Extra time on a named package is $50 per 30 minutes if the next slot is open. Menu prices exclude tax. This quote adds 8.25%.</p>
        <label>
          Discount
          <select id="discount" name="discount">
            {discounts.map((discount) => <option value={discount.id}>{discount.label}</option>)}
          </select>
        </label>
        <fieldset class="checks-field">
          <legend>Add-ons</legend>
          {addons.map((addon) => (
            <label class="checkline">
              <input type="checkbox" name="addon" value={addon.id} />
              <span>
                <strong style="color: #f4f7fb">{addon.name}</strong>
                {" "}— {money(addon.price)}. {addon.detail}
              </span>
            </label>
          ))}
        </fieldset>
        <button class="btn btn-ghost" type="submit">Update this quote</button>
      </form>

      <aside class="panel" aria-live="polite" id="estimate-panel">
        <p class="eyebrow">Planning total</p>
        <h2 class="metal" style="font-size: 2rem" id="estimate-title">Mission</h2>
        <dl id="estimate-lines"></dl>
        <div class="total-row"><span>Subtotal</span><span id="estimate-subtotal">—</span></div>
        <div class="total-row"><span>Tax 8.25%</span><span id="estimate-tax">—</span></div>
        <div class="total-row"><span>Total</span><span id="estimate-total">—</span></div>
        <div class="total-row"><span>Deposit</span><span id="estimate-deposit">—</span></div>
        <div class="total-row"><span>Balance</span><span id="estimate-balance">—</span></div>
        <ul class="note-list" id="estimate-notes"></ul>
        <p class="muted" style="margin-top: 0.8rem">Prices exclude tax. This panel adds 8.25%. The deposit is $100.</p>
        <button class="btn btn-ghost btn-block" type="button" id="copy-estimate" style="margin-top: 0.8rem">
          Copy this estimate link
        </button>
        <p class="status" id="copy-status" role="status"></p>
      </aside>
    </div>
  </section>

</BaseLayout>

<script>
  import { buildEstimate, money } from "../data/pricing";

  const form = document.querySelector<HTMLFormElement>("#planner");
  const pkg = document.querySelector<HTMLSelectElement>("#pkg");
  const date = document.querySelector<HTMLInputElement>("#date");
  const time = document.querySelector<HTMLSelectElement>("#time");
  const town = document.querySelector<HTMLSelectElement>("#town");
  const discount = document.querySelector<HTMLSelectElement>("#discount");
  const hours = document.querySelector<HTMLInputElement>("#hours");
  const extra = document.querySelector<HTMLInputElement>("#extra");
  const lines = document.querySelector<HTMLDListElement>("#estimate-lines");
  const title = document.querySelector<HTMLElement>("#estimate-title");
  const subtotal = document.querySelector<HTMLElement>("#estimate-subtotal");
  const tax = document.querySelector<HTMLElement>("#estimate-tax");
  const total = document.querySelector<HTMLElement>("#estimate-total");
  const deposit = document.querySelector<HTMLElement>("#estimate-deposit");
  const balance = document.querySelector<HTMLElement>("#estimate-balance");
  const notes = document.querySelector<HTMLUListElement>("#estimate-notes");
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-estimate");
  const copyStatus = document.querySelector<HTMLElement>("#copy-status");

  if (form && pkg && date && time && town && discount && hours && extra && lines && title && subtotal && tax && total && deposit && balance && notes) {
    const params = new URLSearchParams(window.location.search);
    const setSelect = (select: HTMLSelectElement, key: string) => {
      const value = params.get(key);
      if (value && [...select.options].some((option) => option.value === value)) select.value = value;
    };
    setSelect(pkg, "pkg");
    setSelect(town, "town");
    setSelect(time, "time");
    setSelect(discount, "discount");
    const dateValue = params.get("date");
    if (dateValue && /^\d{4}-\d{2}-\d{2}$/.test(dateValue)) date.value = dateValue;
    const hourValue = Number(params.get("hours"));
    if (Number.isFinite(hourValue) && hourValue >= 3) hours.value = String(Math.floor(hourValue));
    const extraValue = Number(params.get("extra"));
    if (Number.isFinite(extraValue) && extraValue >= 0) extra.value = String(Math.floor(extraValue));
    const addonParams = new Set((params.get("addons") ?? "").split(",").filter(Boolean));
    form.querySelectorAll<HTMLInputElement>('input[name="addon"]').forEach((input) => {
      input.checked = addonParams.has(input.value);
    });

    const dash = () => {
      subtotal.textContent = "—";
      tax.textContent = "—";
      total.textContent = "—";
      deposit.textContent = "—";
      balance.textContent = "—";
    };

    const render = () => {
      const addonIds = [...form.querySelectorAll<HTMLInputElement>('input[name="addon"]:checked')].map((input) => input.value);
      const result = buildEstimate({
        packageId: pkg.value,
        townId: town.value,
        discount: discount.value,
        addonIds,
        extraHalfHours: Number(extra.value),
        groupHours: Number(hours.value),
        date: date.value,
      });
      lines.replaceChildren();
      notes.replaceChildren();
      if (!result) {
        title.textContent = "Pick a package";
        dash();
        return;
      }
      title.textContent = `${result.packageName} · ${result.townName}`;
      for (const line of result.lines) {
        const row = document.createElement("div");
        row.className = "est-row";
        const label = document.createElement("dt");
        label.textContent = line.label;
        const amount = document.createElement("dd");
        amount.textContent = money(line.amount);
        row.append(label, amount);
        lines.append(row);
      }
      for (const note of result.notes) {
        const item = document.createElement("li");
        item.textContent = note;
        notes.append(item);
      }
      if (result.available) {
        subtotal.textContent = money(result.subtotal);
        tax.textContent = money(result.tax);
        total.textContent = money(result.total);
        deposit.textContent = money(result.deposit);
        balance.textContent = money(result.balance);
      } else {
        dash();
      }

      const next = new URLSearchParams();
      next.set("pkg", pkg.value);
      next.set("town", town.value);
      if (date.value) next.set("date", date.value);
      if (time.value) next.set("time", time.value);
      if (discount.value !== "none") next.set("discount", discount.value);
      if (addonIds.length) next.set("addons", addonIds.join(","));
      if (Number(hours.value) !== 3) next.set("hours", hours.value);
      if (Number(extra.value) > 0) next.set("extra", extra.value);
      const url = `${window.location.pathname}?${next.toString()}`;
      window.history.replaceState(null, "", url);
    };

    form.addEventListener("input", render);
    form.addEventListener("change", render);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      render();
    });
    copyButton?.addEventListener("click", async () => {
      if (!copyStatus) return;
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyStatus.textContent = "Link copied. It includes the package, town, and add-ons, not a private note.";
      } catch {
        copyStatus.textContent = window.location.href;
      }
    });
    render();
  }
</script>

<script>
  const pkgInput = document.querySelector("#req-pkg");
  const dateInput = document.querySelector("#req-date");
  const cityInput = document.querySelector("#req-city");
  const notesInput = document.querySelector("#req-notes");
  if (
    pkgInput instanceof HTMLSelectElement &&
    dateInput instanceof HTMLInputElement &&
    cityInput instanceof HTMLSelectElement &&
    notesInput instanceof HTMLTextAreaElement
  ) {
    const params = new URLSearchParams(window.location.search);
    const pkg = params.get("pkg") ?? "";
    if (pkg && [...pkgInput.options].some((option) => option.value === pkg)) pkgInput.value = pkg;
    const dateValue = params.get("date");
    if (dateValue && /^\d{4}-\d{2}-\d{2}$/.test(dateValue)) dateInput.value = dateValue;
    const town = params.get("town") ?? "";
    if (town && [...cityInput.options].some((option) => option.value === town)) cityInput.value = town;
    else if (town && !notesInput.value) notesInput.value = town;
  }
</script>
