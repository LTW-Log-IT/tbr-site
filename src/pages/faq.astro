---
import CallToBook from "../components/CallToBook.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import { faqSchema, faqs } from "../data/faq";
---

<BaseLayout
  title="FAQ | Team Battle Ready Gaming Trailer"
  description="Parking, power, deposits, cancellations, travel fees, military discount, and Fort Cavazos access for the Team Battle Ready gaming trailer."
  jsonLd={faqSchema(faqs)}
>
  <PageHero eyebrow="Questions" title="Short answers. The policy has the rest." crumb="FAQ">
    <p>
      Prices, the deposit, travel, parking, weather, and the military discount. Soft launch holds a date by phone.
    </p>
  </PageHero>
  <section class="section" style="padding-top: 0.5rem">
    <div class="wrap narrow">
      <FaqList items={faqs} />
      <p style="margin-top: 1.5rem"><CallToBook /></p>
    </div>
  </section>
</BaseLayout>
